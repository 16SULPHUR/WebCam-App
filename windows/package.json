{
  "name": "usb-webcam-bridge-windows",
  "version": "1.0.0",
  "description": "Bridges Android H.264 stream (via ADB forward) to a Windows virtual webcam using FFmpeg + pyvirtualcam",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --output usb_webcam_bridge.exe"
  },
  "pkg": {
    "assets": [
      "dashboard.html"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
